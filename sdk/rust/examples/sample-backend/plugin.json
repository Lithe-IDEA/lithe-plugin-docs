{
  "schemaVersion": 2,
  "id": "org.example.sample-backend",
  "displayName": "Sample Backend",
  "version": "0.1.0",
  "pluginAPIVersion": 3,
  "requires": { "backend": 1, "serverProcess": 1, "ui": 2 },
  "vendor": {
    "id": "org.example",
    "displayName": "Example",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": ["backend.launch", "credentials.store", "ui.contribute", "ui.web"],
  "activationEvents": ["onView:org.example.sample-backend.notes"],
  "languages": [],
  "ui": {
    "toolWindows": [
      {
        "id": "org.example.sample-backend.notes",
        "title": "Sample Notes",
        "placement": "right",
        "web": { "entry": "ui/index.html" }
      }
    ]
  },
  "backend": {
    "launch": { "kind": "packaged", "path": "bin/sample-backend" },
    "arguments": ["--state", "${stateDir}"]
  }
}
